{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pawstash",
  "version": "26.8.1-2",
  "identifier": "app.pawstash.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pawstash",
        "width": 1280,
        "height": 830,
        "visible": false,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "color": "#131313a3"
        }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/background/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' https: http://127.0.0.1:* http://localhost:* asset: https://asset.localhost; img-src 'self' https: data: asset: https://asset.localhost http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
